<component>
	<previews>
		<preview width="320" height="240" style_bg_color="0xeee" />
	</previews>

	<api>
		<prop name="icon" type="image" default="icon_shuffle" />
	</api>

	<styles>
		<style name="style_base" width="80" height="80" radius="40" bg_color="0xffffff" bg_opa="255" />
		<style name="style_pressed" bg_color="0x000000" bg_opa="100" />
		<style name="style_checked" bg_color="0x6688ee" bg_opa="255" />
	</styles>

	<view extends="lv_obj">
		<remove_style_all />
		<style name="style_base" />
		<style name="style_pressed" selector="pressed" />
		<style name="style_checked" selector="checked" />
		<lv_image src="$icon" align="center" />
	</view>
</component>

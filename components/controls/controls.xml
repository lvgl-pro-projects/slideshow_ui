<component>
	<previews>
		<preview width="350" height="350" style_bg_color="0x5c5c5c" />
	</previews>

	<api>
		<!-- Add your API here here. For example 
		<prop name="prop1" type="int" default="0" help="What is this property?"/>
		-->
	</api>

	<styles>
		<style
			name="style_base"
			width="350"
			height="content"
			bg_color="0xffffff"
			bg_opa="120"
			radius="20"
			layout="flex"
			flex_main_place="space_around"
			pad_all="20"
		/>
	</styles>

	<view extends="lv_obj">
		<remove_style_all />
		<style name="style_base" />
		<button icon="icon_settings">
			<subject_set_int_event subject="subject_controls" trigger="clicked" value="0" />
			<subject_set_int_event subject="subject_settings" trigger="clicked" value="1" />
		</button>
		<button icon="icon_shuffle" bind_checked="subject_shuffle">
			<subject_toggle_event subject="subject_shuffle" trigger="clicked" />
		</button>
		<button icon="icon_next">
			<event_cb callback="on_next_cb" trigger="clicked" />
		</button>
	</view>
</component>

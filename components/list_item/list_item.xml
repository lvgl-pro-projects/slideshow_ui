<component>
	<previews>
		<preview width="320" height="240" style_bg_color="0xeee" />
	</previews>

	<api>
		<prop name="title" type="string" default="Title" />
	</api>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="50"
			layout="flex"
			flex_track_place="center"
			flex_main_place="space_between"
			flex_cross_place="center"
			border_width="1"
			border_color="0x686868"
			border_opa="255"
			border_side="bottom"
		/>
	</styles>

	<view extends="lv_obj">
		<remove_style_all />
		<style name="style_base" />
		<lv_label text="$title" />
	</view>
</component>
